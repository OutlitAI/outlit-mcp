{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "outlit": {
      "type": "streamable-http",
      "url": "https://mcp.outlit.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://clerk.outlit.ai/oauth/register",
            "baseScopes": [
              "profile",
              "email",
              "user:org:read",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
